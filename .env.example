APP_NAME="SE SMART PULSA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Postgres (Dokploy / Docker). DATABASE_URL menang bila diisi.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=pulsa
DB_USERNAME=pulsa
DB_PASSWORD=pulsa_dev_only
DATABASE_URL=

# Laravel session/cache tidak dipakai untuk auth API, tetapi tetap butuh driver
# yang tidak bertabrakan dengan tabel `sessions` milik token API.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Paksa cookie token hanya lewat HTTPS di produksi.
COOKIE_SECURE=1

# Midtrans (Snap). Server Key dipakai untuk membuat pembayaran dan memverifikasi
# signature webhook; Client Key untuk Snap.js di frontend (bila dipakai).
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=0
# Opsional: halaman balik setelah pembayaran (default APP_URL/app/transaksi).
MIDTRANS_FINISH_URL=

# Email (SMTP) untuk kode verifikasi saat email akun diganti. Tanpa transport
# nyata (default `log`) kode email tidak terkirim dan perubahan email ditolak.
# Contoh Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_SCHEME=smtp,
# MAIL_USERNAME=<alamat gmail>, MAIL_PASSWORD=<app password>.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="SE SMART PULSA"

# Alternatif tanpa SMTP: Kirisan Send API (set MAIL_MAILER=kirisan).
# Token akun: dash.kirisan.com > Account > Settings.
# Token sender email: dash.kirisan.com > Channel > Email > Emails.
KIRISAN_API_TOKEN=
KIRISAN_EMAIL_TOKEN=

# Fonnte (WhatsApp gateway) untuk mengirim kode OTP verifikasi akun.
# Ambil token di dashboard Fonnte: fonnte.com > Device > Token.
FONNTE_TOKEN=
# Opsional bila memakai endpoint Fonnte lain.
FONNTE_API_URL=https://api.fonnte.com/send
