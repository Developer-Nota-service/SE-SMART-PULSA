# Nilai default SANDBOX (Base44) — bukan kredensial nyata.
# File ini dimuat SEBELUM /run/base44/app.env, sehingga kredensial asli dari
# dashboard selalu menang. Jangan isi nilai rahasia di sini.
# Email OTP (perubahan email) memakai transport Laravel. Di sandbox tidak ada
# SMTP, jadi default-nya `log`: kode tidak terkirim dan ditampilkan sebagai
# `verification.devCode`. Nilai SMTP asli dari dashboard menimpa baris ini.
MAIL_MAILER=log

MIDTRANS_SERVER_KEY=SB-Mid-server-BASE44DEVPLACEHOLDER
MIDTRANS_CLIENT_KEY=SB-Mid-client-BASE44DEVPLACEHOLDER
MIDTRANS_IS_PRODUCTION=0
