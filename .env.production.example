# Contoh environment produksi (satu app, satu domain).
# Isi di dashboard platform deploy — jangan commit file .env asli.

# Wajib: database Postgres milik platform
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Port proses Node (banyak platform mengisi otomatis)
PORT=8000

# Paksa cookie sesi hanya lewat HTTPS
COOKIE_SECURE=1
