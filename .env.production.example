# Environment produksi Laravel (DockHosting / Docker). Jangan commit file .env asli:
# salin nilai-nilai ini ke tab **Environment** project di dashboard hosting.

APP_NAME="SE SMART PULSA"
APP_ENV=production
APP_DEBUG=false
APP_KEY=            # isi hasil: php artisan key:generate --show
APP_URL=https://domainmu.com        # domain/public URL project di hosting

# Postgres "se-smart-pulsa-db" (PostgreSQL 16) — salin dari kartu
# Connection String / Internal Access di dashboard database.
# DATABASE_URL menang bila diisi; DB_* dipakai bila DATABASE_URL kosong.
DATABASE_URL=postgres://postgres:PASSWORD@db-se-smart-pulsa-db-6ae04923:5432/se-smart-pulsa-db
DB_CONNECTION=pgsql
DB_HOST=db-se-smart-pulsa-db-6ae04923
DB_PORT=5432
DB_DATABASE=se-smart-pulsa-db
DB_USERNAME=postgres
DB_PASSWORD=PASSWORD

# Tabel `sessions` dipakai untuk token API, jadi driver session Laravel bukan database.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Cookie token hanya lewat HTTPS
COOKIE_SECURE=1
