# Environment produksi Laravel (Dokploy / Docker). Jangan commit file .env asli.

APP_NAME="SE SMART PULSA"
APP_ENV=production
APP_DEBUG=false
APP_KEY=            # php artisan key:generate --show  → salin hasilnya
APP_URL=https://domainmu.com

# Postgres dari dashboard hosting (DATABASE_URL menang bila diisi)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DB_CONNECTION=pgsql

# Tabel `sessions` dipakai untuk token API, jadi driver session Laravel bukan database.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Cookie token hanya lewat HTTPS
COOKIE_SECURE=1
